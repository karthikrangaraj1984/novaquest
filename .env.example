# Copy to .env (or export these) before `python -m tools.nq up`.
NQ_SECRET_KEY=change-me-to-a-long-random-string
NQ_DATABASE_URL=postgresql://nq_owner:nq_owner@127.0.0.1:54329/novaquest
NQ_APP_DATABASE_URL=postgresql://nq_app:nq_app@127.0.0.1:54329/novaquest
NQ_ADMIN_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/postgres
NQ_BASE_URL=https://localhost:8443

# Claude API (the only cloud service). Leave empty to run fully offline with the built-in engine.
ANTHROPIC_API_KEY=
NQ_MODEL_FAST=claude-haiku-4-5-20251001
NQ_MODEL_STRONG=claude-sonnet-5-5
NQ_AI_DAILY_TOKEN_CAP=2000000

# Optional: let this tool manage a local Postgres cluster
# NQ_PG_BIN=/usr/lib/postgresql/16/bin
# NQ_PG_DATA=/var/lib/novaquest/pgdata

# Optional: local embeddings with Ollama (after `ollama pull nomic-embed-text`)
# NQ_EMBED_URL=http://127.0.0.1:11434

# Optional: make the app reachable from phones on the classroom Wi-Fi (this machine's LAN IP)
# NQ_LAN_SITE=192.168.1.20:8443
